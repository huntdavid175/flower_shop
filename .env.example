# TEMPLATE ONLY — this file IS committed. Never put real keys here.
# Copy it to `.env` (gitignored) and fill that in instead.
#
# Everything is optional until its feature is built, so the dev server boots
# fine with this file mostly empty.

# --- Supabase --------------------------------------------------------------
# Project Settings -> API Keys. Use the current publishable/secret keys, not
# the legacy anon/service_role JWTs.
#
#   publishable (sb_publishable_…)  safe in the browser, respects row-level security
#   secret      (sb_secret_…)       bypasses RLS entirely — server-only, never in client code
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Paystack (Ghana / GHS) ------------------------------------------------
# Use TEST keys (pk_test_… / sk_test_…) throughout development.
# The secret key also verifies webhook signatures.
PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# --- AI --------------------------------------------------------------------
# OpenAI writes/refines gift messages; ElevenLabs speaks them.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# --- Site ------------------------------------------------------------------
# Must be the real public URL in production — QR codes embed it, and they are
# scanned on a phone that is not on your network.
PUBLIC_SITE_URL=http://localhost:4321
