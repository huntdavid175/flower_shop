---
import { Font } from 'astro:assets';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	/**
	 * Let the header sit transparently over the page on very wide screens.
	 * Only for pages that open with a full-bleed hero behind it.
	 */
	overlayHeader?: boolean;
}

const {
	title = 'La Fleur',
	description = 'Discover handpicked flowers and unique arrangements for every occasion. Brighten someone’s day today.',
	overlayHeader = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />

		<Font cssVariable="--font-playfair" preload />
		<Font cssVariable="--font-montserrat" preload />
		<Font cssVariable="--font-parisienne" preload />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
	</head>
	<body>
		<SiteHeader overlay={overlayHeader} />
		<slot />
		<SiteFooter />
	</body>
</html>
