---
import '../../styles/global.css';
import { Font } from 'astro:assets';
import { createAuthClient } from '../../lib/auth';
import { supabaseAdmin } from '../../lib/supabase';

/*
 * There is no signup here, and there should never be one.
 *
 * Accounts are created in the Supabase dashboard and granted access by a row in
 * `staff`. A public signup form on an admin is an open door with a form in
 * front of it.
 *
 * This page is deliberately its own document rather than using AdminLayout:
 * that layout carries the signed-in navigation and a sign-out button, none of
 * which mean anything to someone who is not signed in yet.
 */

let error: string | null = null;
let email = '';
const nextPath = Astro.url.searchParams.get('next') ?? '/admin';

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	email = String(form.get('email') ?? '').trim();
	const password = String(form.get('password') ?? '');

	const client = createAuthClient(Astro.cookies, Astro.request);
	const { data, error: signInError } = await client.auth.signInWithPassword({
		email,
		password,
	});

	if (signInError || !data.user) {
		/*
		 * One message for both a wrong password and an unknown address.
		 * Distinguishing them turns this form into a way to discover which
		 * addresses have accounts.
		 */
		error = 'That email and password do not match.';
	} else {
		const { data: staff } = await supabaseAdmin
			.from('staff')
			.select('is_active')
			.eq('user_id', data.user.id)
			.maybeSingle();

		if (!staff || !staff.is_active) {
			// A real Supabase account, but not one with admin access — sign the
			// session straight back out rather than leaving it lying around.
			await client.auth.signOut();
			error = 'That account does not have access to the shop admin.';
		} else {
			/*
			 * Only ever redirect somewhere inside this site. `next` comes from the
			 * query string, so without this check a link to
			 * /admin/login?next=https://example.com would bounce a signed-in
			 * member of staff straight off to someone else's page.
			 */
			const safeNext =
				nextPath.startsWith('/') && !nextPath.startsWith('//') ? nextPath : '/admin';
			return Astro.redirect(safeNext, 303);
		}
	}
}

const field =
	'mt-2 w-full rounded-none border border-forest-700/50 bg-white px-4 py-3.5 text-[0.9375rem] text-forest-900 outline-none transition-colors duration-200 placeholder:text-forest-700/35 focus:border-terracotta-700';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<meta name="robots" content="noindex,nofollow" />
		<title>Sign in — La Fleur admin</title>
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<Font cssVariable="--font-playfair" preload />
		<Font cssVariable="--font-montserrat" preload />
		<Font cssVariable="--font-parisienne" preload />
	</head>

	<body class="min-h-screen bg-butter font-body text-forest-900">
		<main class="grid min-h-screen lg:grid-cols-[1fr_1.1fr]">
			{/* --- The form --- */}
			<div class="flex items-center justify-center px-6 py-14 sm:px-10">
				<div class="w-full max-w-[26rem]">
					<a
						href="/"
						class="font-logo text-[2.125rem] leading-none text-forest-900 transition-colors hover:text-terracotta-700"
					>
						La Fleur
					</a>
					<p class="mt-1 text-[0.75rem] font-medium uppercase tracking-[0.22em] text-forest-700/55">
						Shop admin
					</p>

					<h1 class="mt-10 font-display text-[clamp(1.75rem,3vw,2.25rem)] leading-tight text-forest-900">
						Welcome back
					</h1>
					<p class="mt-2 text-[0.9375rem] leading-relaxed text-forest-700/70">
						Sign in to see today&rsquo;s orders, print cards and manage the
						catalogue.
					</p>

					<form method="post" class="mt-9">
						{
							error && (
								<p
									class="mb-6 flex items-start gap-3 border border-terracotta-700 bg-white px-4 py-3.5 text-[0.875rem] leading-relaxed text-terracotta-700"
									role="alert"
								>
									<svg
										width="18"
										height="18"
										viewBox="0 0 18 18"
										fill="none"
										aria-hidden="true"
										class="mt-0.5 shrink-0"
									>
										<circle cx="9" cy="9" r="7.75" stroke="currentColor" stroke-width="1.3" />
										<path
											d="M9 5.25v4.5M9 12.25v.5"
											stroke="currentColor"
											stroke-width="1.5"
											stroke-linecap="round"
										/>
									</svg>
									{error}
								</p>
							)
						}

						<label class="block">
							<span class="text-[0.9375rem] font-medium text-forest-700">Email</span>
							<input
								type="email"
								name="email"
								value={email}
								autocomplete="username"
								placeholder="you@lafleur.com"
								required
								autofocus
								class={field}
							/>
						</label>

						<label class="mt-6 block">
							<span class="text-[0.9375rem] font-medium text-forest-700">
								Password
							</span>
							<span class="relative block">
								<input
									type="password"
									name="password"
									autocomplete="current-password"
									placeholder="••••••••"
									required
									class={`${field} pr-24`}
									data-password
								/>
								{/*
								  Typing a password blind on a shared shop machine is how people
								  end up locked out. Only rendered with JavaScript, since it
								  does nothing without it.
								*/}
								<button
									type="button"
									data-reveal
									hidden
									class="absolute right-3 top-1/2 -translate-y-1/2 px-2 py-1 text-[0.8125rem] font-semibold text-forest-700/70 underline underline-offset-4 transition-colors hover:text-terracotta-700"
								>
									Show
								</button>
							</span>
						</label>

						<button
							type="submit"
							data-busy-label="Signing in…"
							class="group mt-8 flex w-full items-center justify-center gap-3 bg-terracotta-700 px-8 py-4 text-[0.9375rem] font-semibold text-white transition-colors duration-300 hover:bg-terracotta-600"
						>
							Sign in
							<svg
								width="18"
								height="12"
								viewBox="0 0 18 12"
								fill="none"
								aria-hidden="true"
								class="transition-transform duration-300 group-hover:translate-x-1"
							>
								<path
									d="M0 6h16M11.5 1l5 5-5 5"
									stroke="currentColor"
									stroke-width="1.3"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
						</button>
					</form>

					<p class="mt-8 border-t border-forest-700/15 pt-6 text-[0.8125rem] leading-relaxed text-forest-700/60">
						Staff accounts are created by the shop owner. If you cannot get in,
						ask them to check your access rather than signing up again &mdash;
						there is no sign-up.
					</p>

					<a
						href="/"
						class="mt-6 inline-block text-[0.875rem] text-forest-700 underline underline-offset-4 transition-colors hover:text-terracotta-700"
					>
						&larr; Back to the shop
					</a>
				</div>
			</div>

			{/* --- The picture. Decorative, so it goes when there is no room. --- */}
			<div class="relative hidden overflow-hidden bg-forest-900 lg:block">
				<img
					src="/images/blooms.png"
					alt=""
					class="h-full w-full object-cover"
				/>
				<div class="absolute inset-0 bg-forest-950/35"></div>
				<div class="texture-grain absolute inset-0 opacity-40"></div>

				<figure class="absolute inset-x-0 bottom-0 p-10 xl:p-14">
					<blockquote class="max-w-md font-display text-[clamp(1.25rem,1.6vw,1.75rem)] leading-[1.45] text-butter">
						Every bouquet leaves here carrying something somebody could not say
						out loud.
					</blockquote>
					<figcaption class="mt-4 text-[0.8125rem] uppercase tracking-[0.18em] text-butter/65">
						La Fleur &middot; Accra
					</figcaption>
				</figure>
			</div>
		</main>

		<script>
			import '../../scripts/form-pending.ts';
		</script>

		<script>
			/*
			 * Progressive enhancement: the button is hidden in the markup and only
			 * revealed here, so it never appears as a dead control.
			 */
			const input = document.querySelector<HTMLInputElement>('[data-password]');
			const toggle = document.querySelector<HTMLButtonElement>('[data-reveal]');

			if (input && toggle) {
				toggle.hidden = false;
				toggle.addEventListener('click', () => {
					const shown = input.type === 'text';
					input.type = shown ? 'password' : 'text';
					toggle.textContent = shown ? 'Show' : 'Hide';
					input.focus();
				});
			}
		</script>
	</body>
</html>
