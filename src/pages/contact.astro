---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { testimonials } from '../data/testimonials';

const sent = Astro.url.searchParams.get('sent');

const address = ['18 Westlands Blvd,', 'Accra, Ghana'];
const directionsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
	address.join(' ').replace(/,$/, ''),
)}`;

const panelHeading =
	'font-display text-[clamp(1.375rem,2.2vw,1.875rem)] leading-none text-forest-700';
const fieldLabel = 'block text-[0.9375rem] text-forest-700';
const field =
	'mt-2 w-full rounded-none border border-forest-700/45 bg-white py-3.5 pl-4 pr-11 text-[0.9375rem] text-forest-900 outline-none transition-colors duration-200 placeholder:text-forest-700/35 focus:border-terracotta-700';
const fieldIcon =
	'pointer-events-none absolute right-4 bottom-4 text-forest-700/55';
const rule = 'border-forest-700/40';
---

<Layout
	title="Contact Us — Elfloral"
	description="Talk to Elfloral about an order, a delivery date, or flowers for an event. 18 Westlands Blvd, Accra."
>
	<section class="bg-butter py-16 lg:py-20">
		<div class="px-5 sm:px-8 lg:px-10 3xl:mx-auto 3xl:max-w-page">
			<PageHeader
				title="Contact Us"
				subtitle="We’re here to help with your floral needs."
			/>

			<div
				id="get-in-touch"
				class={`mt-[clamp(3rem,6vw,7rem)] border ${rule} lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,3fr)]`}
			>
				{/* --- What customers say --- */}
				<div class={`flex flex-col border-b ${rule} lg:border-b-0 lg:border-r`}>
					<h2 class={`border-b px-7 py-6 ${rule} ${panelHeading}`}>
						What Customers Say
					</h2>

					{/*
					  A scroll-snapped list rather than a JavaScript carousel: it swipes
					  natively on a phone and stays usable if the script never runs. The
					  arrows are revealed by that script, so they are never dead controls.
					*/}
					<div class="relative flex flex-1 flex-col">
						<ul
							data-quotes
							class="flex snap-x snap-mandatory overflow-x-auto scroll-smooth [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
						>
							{
								testimonials.map((item) => (
									<li class="flex w-full shrink-0 snap-start flex-col justify-between gap-10 p-7 pb-24">
										<blockquote class="text-[clamp(0.9375rem,1vw,1.0625rem)] leading-[1.7] text-forest-700">
											{item.quote}
										</blockquote>
										<p class="text-[0.9375rem] font-semibold text-forest-700">
											{item.name}
										</p>
									</li>
								))
							}
						</ul>

						<div
							data-quote-nav
							hidden
							class="absolute right-7 bottom-7 flex gap-2"
						>
							<button
								type="button"
								data-quote-prev
								class={`flex size-9 items-center justify-center border ${rule} text-forest-700 transition-colors duration-200 hover:bg-forest-700 hover:text-butter`}
							>
								<span class="sr-only">Previous review</span>
								<svg width="17" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true">
									<path
										d="M18 6H2M6.5 1l-5 5 5 5"
										stroke="currentColor"
										stroke-width="1.3"
										stroke-linecap="round"
										stroke-linejoin="round"></path>
								</svg>
							</button>
							<button
								type="button"
								data-quote-next
								class={`flex size-9 items-center justify-center border ${rule} text-terracotta-700 transition-colors duration-200 hover:bg-terracotta-700 hover:text-white`}
							>
								<span class="sr-only">Next review</span>
								<svg width="17" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true">
									<path
										d="M0 6h16M11.5 1l5 5-5 5"
										stroke="currentColor"
										stroke-width="1.3"
										stroke-linecap="round"
										stroke-linejoin="round"></path>
								</svg>
							</button>
						</div>
					</div>
				</div>

				{/* --- Get in touch --- */}
				<div class="flex flex-col">
					<h2 class={`border-b px-7 py-6 ${rule} ${panelHeading}`}>
						Let&rsquo;s get in touch
					</h2>

					<div class="grid flex-1 gap-10 p-7 lg:grid-cols-2 lg:gap-12 lg:p-9">
						{/* The form */}
						<div class="lg:order-2">
							<p class="text-[clamp(0.9375rem,1.1vw,1.125rem)] leading-[1.6] font-semibold text-forest-700">
								Have a question or feedback? Reach us with the form below, or
								email <span/>
								<a
									href="mailto:hello@elfloral.com"
									class="underline underline-offset-4 hover:text-terracotta-700"
								>
									 hello@elfloral.com
								</a>
							</p>

							{
								sent && (
									<p
										class:list={[
											'mt-6 border px-4 py-3 text-[0.875rem] leading-relaxed',
											sent === 'ok'
												? 'border-forest-700 bg-white text-forest-700'
												: 'border-terracotta-700 bg-white text-terracotta-700',
										]}
										role="status"
									>
										{sent === 'ok' &&
											'Thank you — your message is with us. We reply the same day where we can.'}
										{sent === 'invalid' &&
											'Please check your name, email and message, then send it again.'}
										{sent === 'error' &&
											'Something went wrong our end and your message was not saved. Please try again, or email us directly.'}
									</p>
								)
							}

							<form method="post" action="/api/contact" class="mt-7">
								{/*
								  Honeypot: hidden from people, filled in by crude bots.
								  `tabindex="-1"` and `autocomplete="off"` keep it out of the
								  way of anyone using a keyboard or a password manager.
								*/}
								<div class="sr-only" aria-hidden="true">
									<label for="website">Leave this field empty</label>
									<input
										id="website"
										type="text"
										name="website"
										tabindex="-1"
										autocomplete="off"
									/>
								</div>

								<label class="relative block">
									<span class={fieldLabel}>Your Name</span>
									<input
										type="text"
										name="name"
										required
										autocomplete="name"
										placeholder="Name and Surname"
										class={field}
									/>
									<svg width="18" height="6" viewBox="0 0 18 6" fill="currentColor" class={fieldIcon} aria-hidden="true">
										<circle cx="2" cy="3" r="1.6"></circle>
										<circle cx="9" cy="3" r="1.6"></circle>
										<circle cx="16" cy="3" r="1.6"></circle>
									</svg>
								</label>

								<label class="relative mt-5 block">
									<span class={fieldLabel}>E-mail Address</span>
									<input
										type="email"
										name="email"
										required
										autocomplete="email"
										placeholder="Your mail address"
										class={field}
									/>
									<svg width="19" height="15" viewBox="0 0 19 15" fill="none" class={fieldIcon} aria-hidden="true">
										<rect x="0.75" y="0.75" width="17.5" height="13.5" stroke="currentColor" stroke-width="1.3"></rect>
										<path d="M1 1.5l8.5 6 8.5-6" stroke="currentColor" stroke-width="1.3"></path>
									</svg>
								</label>

								<label class="relative mt-5 block">
									<span class={fieldLabel}>Phone Number</span>
									<input
										type="tel"
										name="phone"
										autocomplete="tel"
										placeholder="024 123 4567"
										class={field}
									/>
									<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class={fieldIcon} aria-hidden="true">
										<path
											d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"
										></path>
									</svg>
								</label>

								<label class="mt-5 block">
									<span class={fieldLabel}>Add a personal message</span>
									<textarea
										name="message"
										rows="4"
										required
										placeholder="Special with love for you ……"
										class={field.replace('pr-11', 'pr-4')}></textarea>
								</label>

								<label class="mt-5 flex items-start gap-3 text-[0.9375rem] text-forest-700">
									<input
										type="checkbox"
										name="marketing"
										class="mt-0.5 size-4 shrink-0 accent-terracotta-700"
									/>
									Receive Elfloral news, offers, and events.
								</label>

								<button
									type="submit"
									data-busy-label="Sending…"
									class="mt-6 w-full bg-terracotta-700 px-8 py-4 text-[0.9375rem] font-semibold text-white transition-colors duration-300 hover:bg-terracotta-600"
								>
									Submit Now
								</button>
							</form>
						</div>
						{/* Where we are */}
						<div class="flex flex-col lg:order-1">
							<address
								class="text-[clamp(1rem,1.2vw,1.25rem)] leading-[1.6] font-semibold text-forest-700 not-italic"
							>
								{address.map((line) => <span class="block">{line}</span>)}
							</address>

							<a
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="group mt-6 inline-flex w-fit items-center gap-3 text-[0.9375rem] font-semibold text-terracotta-700 transition-colors hover:text-terracotta-600"
							>
								Get Directions
								<svg
									width="18"
									height="12"
									viewBox="0 0 18 12"
									fill="none"
									aria-hidden="true"
									class="transition-transform duration-300 group-hover:translate-x-1"
								>
									<path
										d="M0 6h16M11.5 1l5 5-5 5"
										stroke="currentColor"
										stroke-width="1.3"
										stroke-linecap="round"
										stroke-linejoin="round"></path>
								</svg>
							</a>

							<span
								class="mt-10 block aspect-4/5 w-full max-w-[18rem] overflow-hidden bg-forest-700/10 lg:mt-auto"
							>
								<img
									src="/images/testimonial1.jpg"
									alt="A florist holding a finished bouquet in the Elfloral shop"
									loading="lazy"
									decoding="async"
									class="h-full w-full object-cover"
								/>
							</span>
						</div>

					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>

<script>
	/*
	 * Reveal the review arrows only once this runs, so they are never controls
	 * that do nothing. The list itself scrolls and snaps without any of this.
	 */
	const list = document.querySelector<HTMLElement>('[data-quotes]');
	const nav = document.querySelector<HTMLElement>('[data-quote-nav]');

	if (list && nav) {
		nav.hidden = false;

		const step = (direction: 1 | -1) => {
			// One slide is the list's own width — the items are `w-full shrink-0`.
			list.scrollBy({ left: direction * list.clientWidth, behavior: 'smooth' });
		};

		document
			.querySelector('[data-quote-next]')
			?.addEventListener('click', () => step(1));
		document
			.querySelector('[data-quote-prev]')
			?.addEventListener('click', () => step(-1));
	}
</script>
