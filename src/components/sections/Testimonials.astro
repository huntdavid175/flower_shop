---
import SectionHeader from '../SectionHeader.astro';

// One source, shared with the About and Contact pages.
import { testimonials } from '../../data/testimonials';
---

<section aria-labelledby="testimonials" class="bg-butter py-20 lg:py-28">
	<div class="px-5 sm:px-8 lg:px-10 3xl:mx-auto 3xl:max-w-page">
		<SectionHeader id="testimonials" title="What Our Customers Say" />

		<ul
			class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:mt-12 lg:grid-cols-3"
		>
			{
				testimonials.map(
					({ bouquet, quote, name, rating, image, imageAlt }) => (
						/*
						 * The card owns the 5/6 ratio and the photograph takes whatever
						 * height the quote leaves, so every card lines up regardless of
						 * how long its review runs.
						 */
						<li class="texture-grain flex aspect-5/6 flex-col border border-forest-700/50 bg-sand">
							<figure class="p-6">
								<p class="text-[0.9375rem] text-forest-700">
									Bouquet: <span class="ml-1 font-semibold">{bouquet}</span>
								</p>

								<blockquote class="mt-6 text-[0.9375rem] leading-[1.75] text-forest-700">
									{quote}
								</blockquote>

								<figcaption class="mt-8 flex items-center justify-between gap-4 text-[0.9375rem] font-semibold text-forest-700">
									<span>{name}</span>
									<span class="flex shrink-0 items-center gap-1.5">
										<svg
											width="16"
											height="16"
											viewBox="0 0 16 16"
											fill="currentColor"
											aria-hidden="true"
										>
											<path d="M8 1.5l1.9 4.02 4.35.6-3.15 3.1.75 4.38L8 11.53 4.15 13.6l.75-4.38-3.15-3.1 4.35-.6z" />
										</svg>
										<span>
											<span class="sr-only">Rated </span>
											{rating}
											<span class="sr-only"> out of 5</span>
										</span>
									</span>
								</figcaption>
							</figure>

							<div class="relative min-h-0 flex-1">
								<img
									src={image}
									alt={imageAlt}
									loading="lazy"
									decoding="async"
									class="absolute inset-0 h-full w-full object-cover"
								/>
							</div>
						</li>
					),
				)
			}
		</ul>
	</div>
</section>
