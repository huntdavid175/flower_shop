---
/*
 * Bounded height, deliberately not full-screen: it grows with the viewport but
 * stops at 46.5rem, so on a tall display the next section is already peeking
 * above the fold rather than the hero swallowing the whole screen.
 *
 *   short viewport  -> 32rem floor, so the composition never crushes
 *   laptop (~850px) -> ~88vh, matching the reference screenshot
 *   tall display    -> capped at 46.5rem
 */
---

<section
	class="relative isolate flex h-[clamp(32rem,88vh,46.5rem)] flex-col overflow-hidden bg-teal-700"
>
	{/*
	  The photograph carries its own teal backdrop, so it meets the section
	  colour without a seam.

	  Two separate images rather than one crop: the landscape frame loses its
	  subject entirely on a phone. `<picture>` lets the browser fetch only the
	  one it needs — a phone never downloads the desktop file — and it needs no
	  JavaScript, so the hero is never blank while a script decides.
	*/}
	<picture>
		<source media="(min-width: 40rem)" srcset="/images/header.png" />
		<img
			src="/images/header-mobile.png"
			alt=""
			class="absolute inset-0 -z-20 h-full w-full object-cover object-center sm:object-[68%_center]"
			fetchpriority="high"
			decoding="async"
		/>
	</picture>

	{/* Fallback ground, visible only where the photograph does not reach. */}
	<div
		class="absolute inset-0 -z-30 bg-[radial-gradient(120%_100%_at_40%_55%,var(--color-teal-600)_0%,var(--color-teal-800)_55%,var(--color-teal-950)_100%)]"
		aria-hidden="true"
	>
	</div>

	{/*
	  Legibility wash.

	  Now that the copy sits at the top, the wash has to darken the top on a
	  phone — where the portrait photograph fills the whole frame — and the left
	  column on wider screens, where the text and the subject sit side by side.
	*/}
	<div
		class="absolute inset-0 -z-10 bg-gradient-to-b from-teal-950/65 from-0% via-teal-950/25 via-45% to-transparent to-75% sm:bg-gradient-to-r sm:from-teal-950/55 sm:via-teal-950/25 sm:via-30% sm:to-transparent sm:to-55%"
		aria-hidden="true"
	>
	</div>

	{/*
	  Copy at the top of the frame.

	  No `mt-auto`, so it sits where the flex column starts. The 3xl padding is
	  larger because the site header stops being a block above the hero at that
	  width and becomes absolutely positioned over it — 5.375rem of nav plus
	  breathing room, or the headline would run into the menu.
	*/}
	<div
		class="relative w-full px-5 pt-12 sm:px-8 sm:pt-14 lg:px-10 lg:pt-[4.5rem] 3xl:mx-auto 3xl:max-w-page 3xl:pt-[8.75rem]"
	>
		<h1 class="font-display text-hero text-white">
			Fresh Blooms,<br class="hidden sm:block" /> Pure Happiness
		</h1>

		{/*
		  max-width in `em` rather than px, so the measure scales with the font
		  size and the line breaks in the same place at every viewport.
		*/}
		<p class="mt-5 max-w-[32em] text-hero-body font-normal text-cream">
			Discover handpicked flowers and unique arrangements for every occasion.
			Brighten someone&rsquo;s day today.
		</p>

		<a
			href="/shop"
			class="group mt-8 inline-flex items-center gap-3 bg-terracotta-600 px-7 py-4 text-[clamp(0.875rem,0.8vw,1rem)] font-medium tracking-[0.01em] text-white transition-colors duration-300 hover:bg-terracotta-700"
		>
			Shop Now
			<svg
				width="18"
				height="12"
				viewBox="0 0 18 12"
				fill="none"
				aria-hidden="true"
				class="transition-transform duration-300 group-hover:translate-x-1"
			>
				<path
					d="M0 6h16M11.5 1l5 5-5 5"
					stroke="currentColor"
					stroke-width="1.3"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
		</a>
	</div>
</section>
