---
import FeatureIcon from '../FeatureIcon.astro';

const features = [
	{
		icon: 'burst' as const,
		text: 'Next-level gorgeous: highest quality silk flowers',
	},
	{
		icon: 'bloom' as const,
		text: 'Super sustainable: circular & planet proof',
	},
	{
		icon: 'star' as const,
		text: 'Hassle free: the easiest care & free delivery',
	},
];
---

{/*
  The plum lives on the section itself, not on the copy column. That is what
  lets the photograph sit *inside* the panel on mobile — it is padded in, and
  the section's own background shows through around it. From lg the padding
  drops to zero and the photograph becomes a full-bleed grid column instead.
*/}
<section
	aria-labelledby="trusted-boutique"
	class="bg-plum lg:grid lg:split-section"
>
	<div
		class="flex items-center px-5 pt-16 pb-12 sm:px-8 lg:px-10 lg:py-20 3xl:pr-16 3xl:pl-[calc((100vw-var(--container-page))/2)]"
	>
		<div class="w-full max-w-[34rem]">
			<h2
				id="trusted-boutique"
				class="font-display text-[clamp(1.75rem,2.5vw,3rem)] leading-[1.15] text-white"
			>
				Your Trusted Flower<br class="hidden sm:block" /> Boutique Since 2015
			</h2>

			<ul class="mt-8 space-y-3">
				{
					features.map(({ icon, text }) => (
						<li class="flex items-center gap-4 border border-white/25 px-5 py-4 text-[0.9375rem] text-white/90">
							<FeatureIcon name={icon} class="shrink-0 text-white" />
							<span>{text}</span>
						</li>
					))
				}
			</ul>

			<a
				href="/about"
				class="group mt-10 inline-flex items-center gap-3 bg-clay-600 px-7 py-4 text-[0.875rem] font-semibold tracking-[0.01em] text-white transition-colors duration-300 hover:bg-clay-700"
			>
				More About Us
				<svg
					width="18"
					height="12"
					viewBox="0 0 18 12"
					fill="none"
					aria-hidden="true"
					class="transition-transform duration-300 group-hover:translate-x-1"
				>
					<path
						d="M0 6h16M11.5 1l5 5-5 5"
						stroke="currentColor"
						stroke-width="1.3"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
			</a>
		</div>
	</div>

	{/*
	  25/24 is the source's exact ratio (3200x3072), so the inset image on mobile
	  is shown whole — object-position has no effect there. From lg it fills the
	  column and the crop is anchored to the top of the frame.
	*/}
	<div class="px-5 pb-16 sm:px-8 lg:p-0">
		<div class="relative aspect-25/24 lg:aspect-auto lg:h-full">
			<img
				src="/images/trusted.avif"
				alt="A model in red holding a single long-stemmed rose"
				class="absolute inset-0 h-full w-full object-cover object-top"
				loading="lazy"
				decoding="async"
			/>
		</div>
	</div>
</section>
