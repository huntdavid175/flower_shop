---
/*
 * Centred page title and standfirst, shared by the shop listing and the product
 * pages so their type stays in step.
 */
interface Props {
	title: string;
	subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="text-center">
	<h1
		class="font-display text-[clamp(2.5rem,4.6vw,5.5rem)] leading-none text-terracotta-700"
	>
		{title}
	</h1>
	{
		subtitle && (
			<p class="mt-5 text-[clamp(0.875rem,0.75vw,1rem)] font-semibold text-forest-700">
				{subtitle}
			</p>
		)
	}
</div>
