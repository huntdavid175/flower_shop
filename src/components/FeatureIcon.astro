---
/*
 * Small decorative marks for the feature rows. Drawn rather than imported —
 * they are glyphs, not assets, and inlining keeps them recolourable via
 * currentColor.
 */
interface Props {
	name: 'burst' | 'bloom' | 'star';
	class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
	width="18"
	height="18"
	viewBox="0 0 16 16"
	fill="none"
	aria-hidden="true"
	class={className}
>
	{
		name === 'burst' && (
			<>
				<g stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
					<path d="M8 1.5v13M1.5 8h13M3.4 3.4l9.2 9.2M12.6 3.4l-9.2 9.2" />
				</g>
				<circle cx="8" cy="8" r="1.9" fill="currentColor" />
			</>
		)
	}

	{
		name === 'bloom' && (
			<g fill="currentColor">
				<circle cx="8" cy="3.1" r="2.15" />
				<circle cx="12.25" cy="5.55" r="2.15" />
				<circle cx="12.25" cy="10.45" r="2.15" />
				<circle cx="8" cy="12.9" r="2.15" />
				<circle cx="3.75" cy="10.45" r="2.15" />
				<circle cx="3.75" cy="5.55" r="2.15" />
			</g>
		)
	}

	{
		name === 'star' && (
			<g stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
				<path d="M8 1.8v12.4M2.63 4.9l10.74 6.2M2.63 11.1l10.74-6.2" />
			</g>
		)
	}
</svg>
